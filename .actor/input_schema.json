{
    "$schema": "https://apify.com/schemas/v1/input.ide.json",
    "title": "X (Twitter) Scraper Input",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "searchTerms": {
            "title": "Search Terms",
            "type": "array",
            "description": "Satu atau lebih keyword/hashtag. Klik 'Add' untuk menambah baris.",
            "editor": "stringList",
            "items": { "type": "string" },
            "minItems": 1
        },
        "maxItems": {
            "title": "Max Items",
            "type": "integer",
            "description": "Maksimal jumlah tweet yang ingin dikumpulkan.",
            "default": 100,
            "minimum": 1,
            "editor": "number"
        },
        "cookieHeader": {
            "title": "Cookie Header",
            "type": "string",
            "description": "DEPRECATED — tidak dipakai lagi. Cookie dibaca dari environment variable X_COOKIE_HEADER atau dari key-value store (cookie-session/x-main).",
            "editor": "textarea",
            "isSecret": true,
            "sectionCaption": "Lanjutan (opsional)"
        },
        "proxy": {
            "title": "Proxy Configuration",
            "type": "object",
            "description": "Konfigurasi proxy untuk menghindari blokir.",
            "editor": "proxy"
        }
    },
    "required": ["searchTerms"]
}
