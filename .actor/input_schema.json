{
    "$schema": "https://apify.com/schemas/v1/input.ide.json",
    "title": "X (Twitter) Scraper Input",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "searchTerm": {
            "title": "Search Term",
            "type": "string",
            "description": "Keyword atau hashtag yang ingin dicari di X.",
            "editor": "textfield"
        },
        "maxItems": {
            "title": "Max Items",
            "type": "integer",
            "description": "Maksimal jumlah tweet yang ingin dikumpulkan.",
            "default": 100,
            "minimum": 1,
            "editor": "number"
        },
        "cookieHeader": {
            "title": "Cookie Header",
            "type": "string",
            "description": "Cadangan: string header cookies dari Cookie Editor, dipakai kalau file cookie JSON tidak tersedia",
            "editor": "textarea",
            "isSecret": true
        },
        "proxy": {
            "title": "Proxy Configuration",
            "type": "object",
            "description": "Konfigurasi proxy untuk menghindari blokir.",
            "editor": "proxy"
        }
    },
    "required": ["searchTerm"]
}
